configfile: "config.yaml"

wildcard_constraints:
    sample="SRR[0-9]+"

ruleorder: cutadapt > download_fastq

rule all:
    input:
        "results/MA_plot_all_genes.pdf",
        "results/MA_plot_translation.pdf",
        "results/PCA.pdf"
rule download_fastq:
    output: "data/fastq/{sample}.fastq.gz"
    log: "logs/download_fastq/{sample}.log"
    container: "https://zenodo.org/record/10894351/files/sratoolkit_3.1.0.img"
    shell:
        """
        fasterq-dump --threads 4 --progress --outdir data/fastq {wildcards.sample} > {log} 2>&1
        gzip data/fastq/{wildcards.sample}.fastq
        """

rule download_genome:
    output: "data/reference/reference.fasta"
    log: "logs/download_genome.log"
    container: "docker://evolbioinfo/ubuntu:v24.04"
    shell:
        """
        wget -O {output} "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id=CP000253.1&rettype=fasta" > {log} 2>&1
        """

rule download_annotation:
    output: "data/reference/reference.gff"
    log: "logs/download_annotation.log"
    container: "docker://evolbioinfo/ubuntu:v24.04"
    shell:
        """
        wget -O {output} "https://www.ncbi.nlm.nih.gov/sviewer/viewer.cgi?db=nuccore&report=gff3&id=CP000253.1" > {log} 2>&1
        """

rule bowtie_index:
    input: "data/reference/reference.fasta"
    output: expand("data/reference/bowtie_index/reference.{ext}.ebwt", ext=["1", "2", "3", "4", "rev.1", "rev.2"])
    log: "logs/bowtie_index.log"
    container: "containers/bowtie_0.12.7.img"
    shell:
        """
        bowtie-build {input} data/reference/bowtie_index/reference > {log} 2>&1
        """

rule cutadapt:
    input: "data/fastq/{sample}.fastq.gz"
    output: "data/fastq/{sample}.trimmed.fastq.gz"
    log: "logs/cutadapt/{sample}.log"
    container: "https://zenodo.org/records/18834062/files/cutadapt_4.6.0.img"
    shell:
        """
        cutadapt -q 20 -m 25 -a AGATCGGAAGAGC -o {output} {input} > {log} 2>&1
        """

rule mapping:
    input:
        fastq="data/fastq/{sample}.trimmed.fastq.gz",
        index=expand("data/reference/bowtie_index/reference.{ext}.ebwt", ext=["1", "2", "3", "4", "rev.1", "rev.2"])
    output: "data/bam/{sample}.bam"
    log: "logs/mapping/{sample}.log"
    threads: 4
    container: "containers/bowtie_0.12.7.img"
    shell:
        """
        bowtie -p {threads} -S data/reference/bowtie_index/reference <(gunzip -c {input.fastq}) 2> {log} | samtools sort -@ {threads} > {output}
        samtools index {output}
        """

rule featurecounts:
    input:
        bams=expand("data/bam/{sample}.bam", sample=config["samples"]),
        gff="data/reference/reference.gff"
    output: "results/counts.txt"
    log: "logs/featurecounts.log"
    threads: 4
    container: "containers/subread_1.4.6-p3.img"
    shell:
        """
        featureCounts -t gene -g ID -s 1 -F GTF -T {threads} -a {input.gff} -o {output} {input.bams} > {log} 2>&1
        """
rule deseq2:
    input: "results/counts.txt"
    output:
        "results/deseq2_results.tsv",
        "results/MA_plot_all_genes.pdf"
    log: "logs/deseq2.log"
    container: "containers/deseq2.img"
    shell:
        """
        Rscript scripts/deseq2.R {input} results > {log} 2>&1
        """
rule kegg_translation:
    output:
        links="data/kegg/translation_links.tsv",
        genes="data/kegg/sao_genes.tsv"
    log: "logs/kegg_translation.log"
    container: "docker://evolbioinfo/ubuntu:v24.04"
    shell:
        """
        wget -q -O {output.links} https://rest.kegg.jp/link/sao/path:sao03010 2> {log}
        wget -q -O - https://rest.kegg.jp/link/sao/path:sao00970 >> {output.links} 2>> {log}
        wget -q -O {output.genes} https://rest.kegg.jp/list/sao 2>> {log}
        """

rule fig3c:
    input:
        res="results/deseq2_results.tsv",
        links="data/kegg/translation_links.tsv",
        genes="data/kegg/sao_genes.tsv"
    output:
        pdf="results/MA_plot_translation.pdf",
        tsv="results/translation_genes.tsv"
    log: "logs/fig3c.log"
    container: "containers/deseq2.img"
    shell:
        """
        Rscript scripts/fig3c.R {input.res} {input.links} {input.genes} {output.pdf} {output.tsv} > {log} 2>&1
        """

rule pca:
    input: "results/counts.txt"
    output: "results/PCA.pdf"
    log: "logs/pca.log"
    container: "containers/deseq2.img"
    shell:
        """
        Rscript scripts/pca.R {input} {output} > {log} 2>&1
        """
