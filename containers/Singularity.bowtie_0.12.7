Bootstrap: docker
From: ubuntu:22.04

%post
    apt-get update
    apt-get install -y wget unzip ca-certificates
    cd /opt
    wget -q -O bowtie.zip https://sourceforge.net/projects/bowtie-bio/files/bowtie/0.12.7/bowtie-0.12.7-linux-x86_64.zip/download
    unzip bowtie.zip
    rm bowtie.zip
    apt-get clean && rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/opt/bowtie-0.12.7:$PATH
    export LANG=C.UTF-8

%runscript
    exec bowtie "$@"
