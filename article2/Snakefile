configfile:"config.yaml"

rule all:
  input:



rule download_refannot:
  output:
    REF = Index/Mus_musculus.GRCm38.dna.toplevel.fa,
    ANNOT = Index/Mus_musculus.GRCm38.100.gff3
  shell:
    """
#DL ref 
    mkdir Index 
    wget -O {output.REF}.gz https://ftp.ensembl.org/pub/release-100/fasta/mus_musculus/dna/Mus_musculus.GRCm38.dna.toplevel.fa.gz
    gunzip -f {output.REF}.gz

#DL annot
    wget -O {output.ANNOT}.gz https://ftp.ensembl.org/pub/release-100/gff3/mus_musculus/Mus_musculus.GRCm38.100.gff3.gz
    gunzup -f {output.ANNOT}.gz
"""

rule preindex:
  input:
    ref = rule.download_refannot.output.REF,
    annot = rule.download_refannot.output.ANNOT
  output:
    "Index/transcripts.fa"
  conda:
    "envs/agat.yaml"
  shell:
  """
    agat_sp_extract_sequences.pl -g {input.annot} -f {input.ref} -t exon --merge -o {output}
  """
